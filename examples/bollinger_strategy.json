{
  "version": 1,
  "name": "收盘高于布林带上轨示例，20/2为项目演示参数",
  "nodes": [
    {"id": "price", "op": "field", "field": "close"},
    {"id": "upper_band", "op": "bollinger", "input": "price", "window": 20, "multiplier": 2, "band": "upper"},
    {"id": "condition", "op": "gt", "left": "price", "right": "upper_band"}
  ],
  "signal": "condition",
  "allocation": {"when_true": 1.0, "when_false": 0.0}
}
